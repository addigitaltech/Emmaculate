# cPanel/MySQL template. Copy to a private .env outside the public web root; never commit populated values.
APP_NAME="Emmaculate Academy"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://www.yourschooldomain.com
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_URL=
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cpaneluser_emmaculate
DB_USERNAME=cpaneluser_emmaculate
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_FOREIGN_KEYS=true
MYSQL_ATTR_SSL_CA=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true
CACHE_STORE=file
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
MAIL_BROADCAST_PER_MINUTE=60
FILESYSTEM_DISK=public

# Email is required for password resets and payment receipts.
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_URL=
MAIL_HOST=mail.yourschooldomain.com
MAIL_PORT=587
MAIL_USERNAME=noreply@yourschooldomain.com
MAIL_PASSWORD=
MAIL_EHLO_DOMAIN=yourschooldomain.com
MAIL_FROM_ADDRESS=noreply@yourschooldomain.com
MAIL_FROM_NAME="${APP_NAME}"
# Optional alternate mail transports; use the key for the selected transport.
POSTMARK_API_KEY=
RESEND_API_KEY=
# Optional Slack notifications, if enabled by the application.
SLACK_BOT_USER_OAUTH_TOKEN=
SLACK_BOT_USER_DEFAULT_CHANNEL=

# Optional object storage. Configure only when FILESYSTEM_DISK=s3.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Optional payment providers. Keep sandbox/test keys on staging and leave empty to disable checkout.
PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_SECRET_HASH=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_BASE_URL=https://api.flutterwave.com/v3

# Optional Cloudflare Turnstile. Set both keys, list exact hostnames, and keep strict context enabled.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAMES=www.yourschooldomain.com,yourschooldomain.com
TURNSTILE_STRICT_CONTEXT=true

# Optional Termii SMS alerts; blank SMS_DRIVER disables SMS.
SMS_DRIVER=
TERMII_API_KEY=
TERMII_SENDER_ID=
TERMII_BASE_URL=https://api.ng.termii.com
TERMII_CHANNEL=generic

# Optional one-time school:init bootstrap. Use a strong unique password, then remove all three values.
SCHOOL_ADMIN_NAME=
SCHOOL_ADMIN_EMAIL=
SCHOOL_ADMIN_PASSWORD=

# Only for a Docker runtime; cPanel normally does not use this variable.
PORT=80
VITE_APP_NAME="${APP_NAME}"
