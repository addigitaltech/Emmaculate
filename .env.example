# General/local and Docker deployment template. Copy to .env locally; on Render use the protected Environment page.
# Never commit a populated .env file or paste its secret values into issues or documentation.
APP_NAME="Emmaculate Academy"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_LEVEL=debug

# Choose sqlite, mysql, or pgsql. DB_URL, when populated, takes precedence over the DB_* host fields.
DB_CONNECTION=sqlite
DB_URL=
# SQLite: database/database.sqlite. MySQL default port 3306; PostgreSQL default port 5432.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=database/database.sqlite
DB_USERNAME=
DB_PASSWORD=
# MySQL/MariaDB defaults. For PostgreSQL, set DB_CHARSET=utf8; SQLite ignores both values.
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_FOREIGN_KEYS=true
DB_SSLMODE=require
MYSQL_ATTR_SSL_CA=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false
CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log

# Mail is needed for password resets and receipts. Set this to your SMTP provider.
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_URL=
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_EHLO_DOMAIN=
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="${APP_NAME}"
MAIL_BROADCAST_PER_MINUTE=60
# Optional mail transports: use the key for the selected transport, not all at once.
POSTMARK_API_KEY=
RESEND_API_KEY=
# Optional Slack notifications, if enabled by the application.
SLACK_BOT_USER_OAUTH_TOKEN=
SLACK_BOT_USER_DEFAULT_CHANNEL=

# Optional S3-compatible storage (AWS S3 or compatible). Public-disk uploads are public by design.
FILESYSTEM_DISK=public
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Optional online gateways. Use test/sandbox keys outside production; blank disables online checkout.
PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_SECRET_HASH=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_BASE_URL=https://api.flutterwave.com/v3

# Optional Cloudflare Turnstile. Set both keys; keep strict context enabled in production.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAMES=
TURNSTILE_STRICT_CONTEXT=true

# Optional Termii SMS; blank SMS_DRIVER disables SMS.
SMS_DRIVER=
TERMII_API_KEY=
TERMII_SENDER_ID=
TERMII_BASE_URL=https://api.ng.termii.com
TERMII_CHANNEL=generic

# One-time Docker startup bootstrap only; prefer `php artisan school:create-super-admin`.
# If used, set a strong unique password temporarily and remove all three after first boot.
SCHOOL_ADMIN_NAME=
SCHOOL_ADMIN_EMAIL=
SCHOOL_ADMIN_PASSWORD=

# Render injects PORT at runtime; Docker defaults to port 80 for local runs.
PORT=80
VITE_APP_NAME="${APP_NAME}"
